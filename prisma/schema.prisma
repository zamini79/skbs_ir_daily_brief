generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id            String  @id @default(cuid())
  category      String  // 국내사 | 해외사 | Index
  displayOrder  Int
  name          String
  currency      String
  quoteSource   String  // naver-stock | naver-index | twelvedata | marketstack | manual
  quoteSymbol   String
  newsQuery     String
  /// 관련성 필터용 콤마 구분 별칭 목록. 비어 있으면 파이프라인이 name 하나로 폴백한다.
  newsAliases   String  @default("")
  isIndex       Boolean @default(false)

  /// 해외사 시총 계산용. 국내사는 네이버가 시총을 직접 주므로 null.
  sharesOutstanding      BigInt?
  /// 런던 펜스 호가 보정. GSK=100, 그 외=1.
  priceDivisorForMarketCap Int  @default(1)

  quotes     QuoteSnapshot[]
  candidates NewsCandidate[]
  selections Selection[]
  yearOpens  YearOpenPrice[]

  @@unique([displayOrder])
}

model YearOpenPrice {
  id           String     @id @default(cuid())
  instrumentId String
  year         Int
  price        Decimal
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, year])
}

model BriefRun {
  id         String   @id @default(cuid())
  /// 시세 기준일(직전 영업일). 뉴스 기준일과 다를 수 있다.
  tradeDate  String
  /// 실행 당일 KST 날짜. 검수 화면 URL 키.
  runDate    String
  status     String   // COLLECTING | READY | PARTIAL | FAILED
  /// status가 PARTIAL/FAILED일 때 사람이 읽을 수 있는 사유(예: 요약 20건 실패, 할당량 소진).
  statusDetail String? @db.Text
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  quotes     QuoteSnapshot[]
  candidates NewsCandidate[]
  selections Selection[]

  @@unique([runDate])
}

model QuoteSnapshot {
  id           String   @id @default(cuid())
  runId        String
  instrumentId String
  close        Decimal?
  prevClose    Decimal?
  changePct    Float?
  ytdPct       Float?
  marketCapKrwTrillion Decimal?
  fxRate       Float?
  /// 소스가 알려준 시세 기준일. 소스마다 다르므로 반드시 저장한다.
  asOf         String?
  sourceName   String
  errorMessage String?  @db.Text
  fetchedAt    DateTime @default(now())

  run        BriefRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([runId, instrumentId])
}

model NewsCandidate {
  id           String   @id @default(cuid())
  runId        String
  instrumentId String
  rank         Int      // 1..3
  title        String   @db.Text
  url          String   @db.Text
  publisher    String
  publishedAt  DateTime
  /// 같은 사건을 다룬 매체 수. 이 값이 '빈도'다.
  clusterSize  Int
  /// 이 후보가 더 높은 순위(작은 rank) 후보와 같은 사건이면 그 rank. rank 1은 항상 null.
  sameEventAsRank Int?
  /// 요약 실패 사유. 성공하거나 본문 부족으로 건너뛴 경우 null. 후보 자체는 지우지 않는다 —
  /// 담당자가 제목만 보고 판단할 수 있게 남긴다.
  summaryError String? @db.Text
  /// 3안을 실제로 만들어낸 모델(예: gemini-3.6-flash). 폴백 체인 중 몇 번째
  /// 모델이 응답했는지 나중에 추적한다. 실패했거나 아직 요약하지 않았으면 null.
  summaryModel String?

  run        BriefRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  instrument Instrument    @relation(fields: [instrumentId], references: [id])
  summaries  NewsSummary[]
  /// 이 후보를 골랐던 Selection들. 재실행으로 이 후보가 삭제되면 DB가 그쪽 FK를 null로
  /// 되돌린다(onDelete: SetNull) — 검수자의 선택이 존재하지 않는 행을 조용히 가리키는
  /// 일이 없도록.
  chosenBy   Selection[]   @relation("ChosenCandidate")

  @@unique([runId, instrumentId, rank])
}

model NewsSummary {
  id          String @id @default(cuid())
  candidateId String
  variant     Int    // 1=수치 2=배경 3=시사점
  text        String @db.Text
  /// 모델이 만든 게 아니라 기사 본문/스니펫에서 기계적으로 발췌한 대체 텍스트면 true.
  /// 요약이 전부 실패했을 때 화면을 비워두지 않기 위한 것 — 검수자가 모델 산출물로
  /// 착각하지 않도록 반드시 구분해서 보여줘야 한다.
  isFallback  Boolean @default(false)

  candidate NewsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// NewsCandidate.chosenBy 와 같은 이유로 존재한다.
  chosenBy  Selection[]   @relation("ChosenSummary")

  @@unique([candidateId, variant])
}

model Selection {
  id           String   @id @default(cuid())
  runId        String
  instrumentId String
  decision     String   @default("PENDING") // PENDING | SELECTED | OMITTED
  chosenCandidateId String?
  chosenSummaryId   String?
  editedText   String?  @db.Text
  /// 코스피200 헬스케어 전용 수기 입력.
  manualClose     Decimal?
  manualPrevClose Decimal?
  updatedAt    DateTime @updatedAt

  run        BriefRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id])
  /// 재실행으로 후보가 재생성되면 이전 후보 id는 사라진다. FK가 SetNull로 정리해
  /// 죽은 참조가 아니라 명확한 null로 남긴다 — 이 값이 null로 바뀌면 파이프라인이
  /// decision도 함께 PENDING으로 되돌린다(editedText는 검수자의 작업물이므로 보존).
  chosenCandidate NewsCandidate? @relation("ChosenCandidate", fields: [chosenCandidateId], references: [id], onDelete: SetNull)
  chosenSummary   NewsSummary?   @relation("ChosenSummary", fields: [chosenSummaryId], references: [id], onDelete: SetNull)

  @@unique([runId, instrumentId])
}
